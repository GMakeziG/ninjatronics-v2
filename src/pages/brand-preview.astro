---
// TEMPORARY review page for the logo proposal. noindex; delete before launch
// (tracked for Milestone 4 QA). Not linked from navigation.
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import BranchLines from "../components/BranchLines.astro";

const palette = [
  { key: "ink", name: "Ink Black", hex: "#101214", role: "Primary background" },
  { key: "graphite", name: "Graphite", hex: "#1C2124", role: "Surfaces and panels" },
  { key: "paper", name: "Warm Paper", hex: "#F0EDE6", role: "Text and light surfaces" },
  { key: "vermilion", name: "Vermilion", hex: "#E15A3B", role: "Change, diffs, emphasis, main branch" },
  { key: "sage", name: "Muted Sage", hex: "#A8B6AE", role: "Supporting text, secondary elements" },
  { key: "teal", name: "Signal Teal", hex: "#2FD3C6", role: "Accent only; glow on logo prompt only" },
];

// Rasterized PNGs, so the 4× zoom shows the real pixels a browser tab gets.
const favicons = [
  { size: 64, src: "/brand/favicon-64.png", label: "64px (desktop)" },
  { size: 32, src: "/brand/favicon-32.png", label: "32px (tab)" },
  { size: 16, src: "/brand/favicon-16.png", label: "16px (simplified)" },
];
---

<BaseLayout title="Brand preview (proposal)" noindex>
  <div class="container preview">
    <header>
      <p class="kicker">Proposal: pending approval</p>
      <h1>Logo and favicon proposal</h1>
      <p class="note">
        An SVG reconstruction of <code>docs/design/ninjatronics-logo-reference4.png</code>. The originals are
        raster renders with brushed-metal texture and are always composited with backgrounds, so they can't be
        cropped cleanly. Two-tone blade facets stand in for the metal. If you can export the approved mark from
        Canva as a transparent PNG/SVG, it can replace these files with no code changes.
      </p>
    </header>

    <section aria-labelledby="h-header">
      <h2 id="h-header">1. Header lockup</h2>
      <div class="pair">
        <div class="surface surface--dark"><Logo href="#h-header" /></div>
        <div class="surface surface--light"><Logo href="#h-header" /></div>
      </div>
    </section>

    <section aria-labelledby="h-primary">
      <h2 id="h-primary">2. Primary mark with supporting git lines (dark / light)</h2>
      <div class="pair">
        <div class="surface surface--dark lockup">
          <BranchLines class="lockup__lines" />
          <img src="/brand/shuriken-mark.svg" width="220" height="220" alt="Primary mark on Ink Black" />
        </div>
        <div class="surface surface--light lockup">
          <BranchLines class="lockup__lines" />
          <img src="/brand/shuriken-mark.svg" width="220" height="220" alt="Primary mark on Warm Paper" />
        </div>
      </div>
    </section>

    <section aria-labelledby="h-compact">
      <h2 id="h-compact">3. Compact mark (no git lines) at 120 / 64 / 40px</h2>
      <div class="pair">
        {
          ["dark", "light"].map((tone) => (
            <div class={`surface surface--${tone} row`}>
              {[120, 64, 40].map((s) => (
                <img src="/brand/shuriken-mark-compact.svg" width={s} height={s} alt={`Compact mark ${s}px on ${tone}`} />
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="h-favicon">
      <h2 id="h-favicon">4. Favicons: actual size, then 4× zoom (no glow, flat fills)</h2>
      <div class="pair">
        {
          ["dark", "light"].map((tone) => (
            <div class={`surface surface--${tone} row`}>
              {favicons.map((f) => (
                <figure>
                  <img src={f.src} width={f.size} height={f.size} alt="" />
                  <img class="zoom" src={f.src} width={f.size * 4} height={f.size * 4} alt="" />
                  <figcaption>{f.label}</figcaption>
                </figure>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="h-palette">
      <h2 id="h-palette">5. Palette</h2>
      <ul class="palette">
        {
          palette.map((c) => (
            <li>
              <span class={`swatch swatch--${c.key}`} />
              <strong>{c.name}</strong>
              <code>{c.hex}</code>
              <span>{c.role}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .preview {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .kicker {
    color: var(--accent-change);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--step-h1);
    margin-block: var(--space-2) var(--space-4);
  }

  h2 {
    font-size: var(--step-h3);
    margin-bottom: var(--space-4);
  }

  .note {
    max-width: var(--measure);
    color: var(--text-secondary);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-4);
  }

  .surface {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--border-subtle);
  }

  .surface--dark {
    background: var(--brand-ink);
    color: var(--brand-paper);
    --surface-page: var(--brand-ink);
  }

  .surface--light {
    background: var(--brand-paper);
    color: var(--brand-ink);
    --surface-page: var(--brand-paper);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-5);
  }

  .lockup {
    display: grid;
    align-items: center;
    justify-items: center;
    overflow: hidden;
  }

  .lockup > :global(*) {
    grid-area: 1 / 1;
  }

  /* :global(): the SVG is rendered by BranchLines.astro, outside this scope. */
  .lockup :global(.lockup__lines) {
    width: 130%;
    max-width: none;
    margin-left: -10%;
    justify-self: start;
    opacity: 0.85;
  }

  .lockup img {
    position: relative;
  }

  figure {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin: 0;
  }

  .zoom {
    image-rendering: pixelated;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
  }

  .palette {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .palette li {
    display: grid;
    gap: var(--space-1);
    font-size: var(--step-small);
    color: var(--text-secondary);
  }

  .palette strong {
    color: var(--text-primary);
  }

  .swatch {
    height: 4rem;
    border-radius: var(--radius-sm);
    border: var(--border-width) solid var(--border-strong);
  }

  /* Classes, not inline styles: the CSP allows no inline styles. */
  .swatch--ink { background: var(--brand-ink); }
  .swatch--graphite { background: var(--brand-graphite); }
  .swatch--paper { background: var(--brand-paper); }
  .swatch--vermilion { background: var(--brand-vermilion); }
  .swatch--sage { background: var(--brand-sage); }
  .swatch--teal { background: var(--brand-teal); }
</style>
