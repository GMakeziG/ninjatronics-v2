---
// Article template (reference: article panel in ninjatronics-v2-reference.png).
// Pages pass the rendered <Content /> into the default slot.
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import TagList from "../components/TagList.astro";
import CopyCode from "../components/CopyCode.astro";
import { AUTHOR, SITE } from "../config/site";
import { getCategory } from "../config/categories";
import { categoryPath, postPath, type Post } from "../lib/posts";
import { readingMinutes } from "../lib/reading-time";
import { formatDate, isoDate } from "../lib/format";
import "../styles/prose.css";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  older?: Post;
  newer?: Post;
  related: Post[];
}

const { post, headings, older, newer, related } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, draft, cover, coverAlt, toc } = post.data;

const categoryInfo = getCategory(category);
const minutes = readingMinutes(post.body);
const sectionCount = headings.filter((h) => h.depth === 2).length;
const showToc = toc ?? sectionCount >= 3;
const url = new URL(postPath(post), Astro.site ?? SITE.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  url,
  articleSection: categoryInfo.label,
  keywords: tags.join(", ") || undefined,
  image: cover ? new URL(cover.src, Astro.site ?? SITE.url).href : undefined,
  wordCount: post.body?.split(/\s+/).filter(Boolean).length,
};
---

<BaseLayout
  title={title}
  description={description}
  noindex={draft}
  image={cover ? { src: cover.src, alt: coverAlt ?? "" } : undefined}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, section: categoryInfo.label, tags, author: AUTHOR.name }}
  jsonLd={jsonLd}
>
  {
    draft && (
      <div class="draft-banner" role="status">
        <div class="container">
          <strong>Draft</strong>: visible in development only. Excluded from production pages, RSS, and the sitemap.
        </div>
      </div>
    )
  }

  <article class="container article" data-has-toc={showToc ? "true" : undefined}>
    <header class="article__header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a class="breadcrumb__section" href={categoryPath(category)}>{categoryInfo.label}</a></li>
        </ol>
      </nav>
      <p class="article__category"><a href={categoryPath(category)}>{categoryInfo.label}</a></p>
      <h1 class="article__title">{title}</h1>
      <p class="article__lede">{description}</p>
      <div class="article__meta">
        <span>By {AUTHOR.name}</span>
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        <span>{minutes} min read</span>
      </div>
      <TagList tags={tags} label="Article tags" />
    </header>

    {
      cover && (
        <Image class="article__cover" src={cover} alt={coverAlt ?? ""} widths={[720, 1080, 1440]} sizes="(min-width: 72rem) 1080px, 100vw" loading="eager" fetchpriority="high" />
      )
    }

    {showToc && <div class="article__toc-inline"><TableOfContents headings={headings} variant="inline" /></div>}

    <div class="article__layout">
      <div class="prose">
        <slot />
      </div>
      {showToc && <aside class="article__toc-sidebar"><TableOfContents headings={headings} variant="sidebar" /></aside>}
    </div>

    <footer class="article__footer">
      {
        (older || newer) && (
          <nav class="pager" aria-label="More articles">
            {newer && (
              <a class="pager__link pager__link--newer" href={postPath(newer)}>
                <span class="pager__label">Newer</span>
                <span class="pager__title">{newer.data.title}</span>
              </a>
            )}
            {older && (
              <a class="pager__link pager__link--older" href={postPath(older)}>
                <span class="pager__label">Older</span>
                <span class="pager__title">{older.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title" class="related__title">Related articles</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={postPath(r)}>{r.data.title}</a>
                  <span>{getCategory(r.data.category).label}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </footer>
  </article>
  <CopyCode />
  <script>
    // Tables wider than the reading column scroll horizontally. Make only those
    // focusable so keyboard users can scroll them (Chrome and Firefox already
    // do this for scroll containers; Safari doesn't).
    let frame = 0;
    function markScrollableTables() {
      frame = 0;
      for (const table of document.querySelectorAll<HTMLTableElement>(".prose table")) {
        if (table.scrollWidth > table.clientWidth + 1) table.tabIndex = 0;
        else table.removeAttribute("tabindex");
      }
    }
    markScrollableTables();
    window.addEventListener("resize", () => (frame ||= requestAnimationFrame(markScrollableTables)), { passive: true });
  </script>
</BaseLayout>

<style>
  .draft-banner {
    padding-block: var(--space-3);
    background: var(--surface-panel);
    border-bottom: var(--border-width) dashed var(--accent-change);
    color: var(--text-secondary);
    font-size: var(--step-small);
  }

  .draft-banner strong {
    color: var(--accent-change);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .article {
    padding-top: var(--space-page-start);
  }

  .article__header {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: var(--measure);
    margin-bottom: var(--space-6);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-small);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-2);
    color: var(--text-secondary);
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .breadcrumb .breadcrumb__section {
    color: var(--accent-link);
  }

  .article__category a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--accent-change);
    border-radius: var(--radius-pill);
    color: var(--accent-change);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .article__title {
    font-size: var(--step-h1);
  }

  .article__lede {
    color: var(--text-secondary);
    font-size: var(--step-body-lg);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
  }

  .article__cover {
    width: 100%;
    height: auto;
    margin-bottom: var(--space-6);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .article__toc-inline {
    max-width: var(--measure);
    margin-bottom: var(--space-6);
  }

  .article__toc-sidebar {
    display: none;
  }

  .article__layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    [data-has-toc] .article__layout {
      grid-template-columns: minmax(0, var(--measure)) minmax(12rem, 16rem);
    }

    .article__toc-inline {
      display: none;
    }

    .article__toc-sidebar {
      display: block;
      position: sticky;
      top: var(--space-5);
      align-self: start;
      max-height: calc(100dvh - var(--space-7));
      overflow-y: auto;
      /* Long TOCs scroll on their own without dragging the page along. */
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: var(--border-strong) transparent;
    }
  }

  .article__footer {
    display: grid;
    gap: var(--space-7);
    max-width: var(--measure);
    margin-top: var(--space-8);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
  }

  .pager__link {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-card);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    text-decoration: none;
  }

  .pager__link:hover {
    border-color: var(--border-strong);
  }

  .pager__link--older {
    text-align: right;
  }

  .pager__label {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pager__title {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .related__title {
    font-size: var(--step-h3);
    margin-bottom: var(--space-3);
  }

  .related ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .related span {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }
</style>
