---
// Flat mono chips for short labels (technologies, skills). Same visual
// treatment as the About page's skill chips.
interface Props {
  items: string[];
  /** Accessible name for the list, e.g. "Technologies". */
  label?: string;
}

const { items, label } = Astro.props;
---

<ul class="chip-list" aria-label={label}>
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--border-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
  }
</style>
