---
import Logo from "./Logo.astro";
import { FOOTER_NAV, SITE } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo size={32} />
      <p>{SITE.description}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {FOOTER_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={SITE.github} rel="me">GitHub</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer__legal">
    <p>© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: var(--step-small);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6) var(--space-3);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-3);
    max-width: 26rem;
    color: var(--text-primary);
  }

  .site-footer__brand p {
    color: var(--text-secondary);
  }

  .site-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .site-footer nav a:hover {
    color: var(--text-primary);
  }

  .site-footer__legal {
    padding-block: var(--space-3) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
  }
</style>
