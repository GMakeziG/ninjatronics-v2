---
// Temporary page body for sections whose content isn't ready yet. Gives every
// navigation destination a real, honest page instead of a 404, without
// inventing content. Replace page by page in Milestones 2–3.
interface Props {
  title: string;
  /** Short, factual description of what will live here. */
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="container pending" aria-labelledby="pending-title">
  <h1 id="pending-title" class="pending__title">{title}</h1>
  <p class="pending__intro">{intro}</p>
  <div class="pending__notice" role="note">
    <p class="pending__label">Status: in preparation</p>
    <p>This section is being prepared. Content will be published here once it's ready.</p>
  </div>
  <p class="pending__back"><a href="/">← Back to the homepage</a></p>
</section>

<style>
  .pending {
    display: grid;
    gap: clamp(var(--space-4), 0.75rem + 1vw, var(--space-5));
    justify-items: start;
    padding-top: var(--space-page-start);
  }

  .pending__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--step-h1);
  }

  .pending__title::before {
    content: "";
    flex: none;
    width: 6px;
    height: 0.85em;
    background: var(--accent-change);
  }

  .pending__intro {
    max-width: var(--measure);
    color: var(--text-secondary);
    font-size: var(--step-body-lg);
  }

  .pending__notice {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    max-width: var(--measure);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-card);
    border: var(--border-width) dashed var(--border-strong);
    border-radius: var(--radius-md);
  }

  .pending__label {
    color: var(--accent-change);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .pending__back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--step-small);
    text-decoration: none;
  }

  .pending__back a:hover {
    text-decoration: underline;
  }
</style>
