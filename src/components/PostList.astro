---
// Scannable article list for the blog index, category, and tag pages
// (reference: v3 "Index" layout: title, category, reading time).
import { getCategory } from "../config/categories";
import { postPath, type Post } from "../lib/posts";
import { readingMinutes } from "../lib/reading-time";
import { formatDate, isoDate } from "../lib/format";

interface Props {
  posts: Post[];
  /** Shown when the list is empty. */
  emptyMessage?: string;
}

const { posts, emptyMessage = "No articles have been published yet." } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{emptyMessage}</p>
  ) : (
    <ol class="posts">
      {posts.map((post) => (
        <li class="post">
          <article>
            <p class="post__meta">
              <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
              <span class="post__category">{getCategory(post.data.category).label}</span>
              <span>{readingMinutes(post.body)} min read</span>
              {post.data.draft && <span class="post__draft">Draft</span>}
            </p>
            <h2 class="post__title">
              <a href={postPath(post)}>{post.data.title}</a>
            </h2>
            <p class="post__description">{post.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
  )
}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-width) solid var(--border-subtle);
  }

  .post {
    position: relative;
    padding-block: var(--space-5);
    border-bottom: var(--border-width) solid var(--border-subtle);
  }

  .post article {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
  }

  .post__category {
    color: var(--accent-change);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    font-size: var(--step-micro);
    align-self: center;
  }

  .post__draft {
    padding: 0 var(--space-2);
    border: var(--border-width) dashed var(--accent-change);
    border-radius: var(--radius-sm);
    color: var(--accent-change);
    text-transform: uppercase;
    font-size: var(--step-micro);
  }

  .post__title {
    font-size: var(--step-h3);
  }

  .post__title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  /* Whole row is clickable via the title link. */
  .post__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post__title a:hover {
    text-decoration: underline;
  }

  .post:has(a:focus-visible) {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: 2px;
  }

  .post__title a:focus-visible {
    outline: none;
  }

  .post__description {
    color: var(--text-secondary);
  }

  .empty {
    padding: var(--space-5);
    background: var(--surface-card);
    border: var(--border-width) dashed var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    max-width: var(--measure);
  }
</style>
