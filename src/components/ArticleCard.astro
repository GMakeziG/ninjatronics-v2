---
// Article summary card (reference: "Latest Articles" row on the homepage).
import { formatDate, isoDate } from "../lib/format";

interface Props {
  title: string;
  category: string;
  excerpt: string;
  href: string;
  date: Date;
  readingMinutes: number;
  /** Drafts only render in `astro dev`; label them so they're never mistaken for published work. */
  draft?: boolean;
  /** Heading level inside the surrounding section. */
  headingLevel?: 2 | 3;
}

const { title, category, excerpt, href, date, readingMinutes, draft = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<article class:list={["card", { "card--draft": draft }]}>
  <div class="card__media" aria-hidden="true">
    {draft && <span class="card__flag">Draft</span>}
  </div>
  <div class="card__body">
    <p class="card__category">{category}</p>
    <Heading class="card__title"><a href={href}>{title}</a></Heading>
    <p class="card__excerpt">{excerpt}</p>
    <p class="card__meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span>{readingMinutes} min read</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .card:has(a:hover),
  .card:has(a:focus-visible) {
    border-color: var(--border-strong);
  }

  .card:has(a:focus-visible) {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: 2px;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card--draft {
    border-style: dashed;
    border-color: var(--accent-change);
  }

  /* Flat media slot: a quiet graphite panel with a single main-branch line. */
  .card__media {
    position: relative;
    aspect-ratio: 16 / 7;
    background:
      linear-gradient(var(--graphic-main), var(--graphic-main)) left 50% / 100% 2px no-repeat,
      var(--surface-panel);
  }

  .card__flag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 2px var(--space-2);
    border: var(--border-width) dashed var(--accent-change);
    border-radius: var(--radius-sm);
    background: var(--surface-page);
    color: var(--accent-change);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .card__category {
    color: var(--accent-change);
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .card__title {
    font-size: var(--step-h3);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Whole card is clickable via the title link's stretched hit area. */
  .card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card__title a:hover {
    text-decoration: underline;
  }

  .card__excerpt {
    color: var(--text-secondary);
    font-size: var(--step-small);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--step-meta);
  }
</style>
