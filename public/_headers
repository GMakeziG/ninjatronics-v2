# Response headers for the Cloudflare Worker's static assets.
# Copied to dist/_headers at build time. See docs/deployment.md.
#
# Content-Security-Policy: no inline scripts or styles anywhere.
#   - Astro emits CSS and JS as files (astro.config.mjs: inlineStylesheets
#     "never", assetsInlineLimit 0).
#   - Code highlighting uses classes, not inline styles (src/lib/shiki.ts).
#   - JSON-LD <script type="application/ld+json"> is data, never executed.
#   - No third-party origins: fonts are self-hosted; no analytics.
# HSTS is deliberately absent: it's enabled on the zone after cutover,
# starting with a short max-age.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Rules below replace (not append to) the default Cache-Control: "! Name"
# detaches the header inherited from /*, which would otherwise be merged
# into one contradictory value.

# Fingerprinted build assets (CSS, JS, fonts, images): safe to cache forever.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Brand files and icons keep stable names, so cache for a day only.
/brand/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Feeds and sitemaps: an hour.
/rss.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
